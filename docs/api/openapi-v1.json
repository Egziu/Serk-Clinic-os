  "components": {
    "schemas": {
      "AddAllergyRequest": {
        "required": [
          "substance",
          "reaction",
          "severity"
        ],
        "type": "object",
        "properties": {
          "substance": {
            "type": [
              "null",
              "string"
            ]
          },
          "reaction": {
            "type": [
              "null",
              "string"
            ]
          },
          "severity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AllergySeverity"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "AddendumRequest": {
        "required": [
          "text",
          "reason"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "AllergyRecordStatus": {
        "enum": [
          "Active",
          "Inactive",
          "EnteredInError",
          null
        ]
      },
      "AllergySeverity": {
        "enum": [
          "Mild",
          "Moderate",
          "Severe",
          "Unknown",
          null
        ]
      },
      "BookAppointmentRequest": {
        "required": [
          "patientId",
          "practitionerId",
          "startsAt",
          "durationMinutes",
          "reason"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "practitionerId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "durationMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "ChangeAllergyStatusRequest": {
        "required": [
          "status",
          "reason"
        ],
        "type": "object",
        "properties": {
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AllergyRecordStatus"
              }
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreateDocumentRequest": {
        "required": [
          "noteVersionId",
          "paperSize"
        ],
        "type": "object",
        "properties": {
          "noteVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "paperSize": {
            "oneOf": [
              {
