  "components": {
    "schemas": {
      "AddAllergyRequest": {
        "required": [
          "substance",
          "reaction",
          "severity"
        ],
        "type": "object",
        "properties": {
          "substance": {
            "type": [
              "null",
              "string"
            ]
          },
          "reaction": {
            "type": [
              "null",
              "string"
            ]
          },
          "severity": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AllergySeverity"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "AddendumRequest": {
        "required": [
          "text",
          "reason"
        ],
        "type": "object",
        "properties": {
          "text": {
            "type": [
              "null",
              "string"
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "AllergyRecordStatus": {
        "enum": [
          "Active",
          "Inactive",
          "EnteredInError",
          null
        ]
      },
      "AllergySeverity": {
        "enum": [
          "Mild",
          "Moderate",
          "Severe",
          "Unknown",
          null
        ]
      },
      "BookAppointmentRequest": {
        "required": [
          "patientId",
          "practitionerId",
          "startsAt",
          "durationMinutes",
          "reason"
        ],
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string",
            "format": "uuid"
          },
          "practitionerId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "durationMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "ChangeAllergyStatusRequest": {
        "required": [
          "status",
          "reason"
        ],
        "type": "object",
        "properties": {
          "status": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/AllergyRecordStatus"
              }
            ]
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "CreateDocumentRequest": {
        "required": [
          "noteVersionId",
          "paperSize"
        ],
        "type": "object",
        "properties": {
          "noteVersionId": {
            "type": "string",
            "format": "uuid"
          },
          "paperSize": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/PaperSize"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": [
              "null",
              "string"
            ]
          },
          "password": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "NoteContentV1": {
        "required": [
          "chiefComplaint",
          "history",
          "examination",
          "assessment",
          "plan"
        ],
        "type": "object",
        "properties": {
          "chiefComplaint": {
            "type": "string"
          },
          "history": {
            "type": "string"
          },
          "examination": {
            "type": "string"
          },
          "assessment": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "PaperSize": {
        "enum": [
          "A4",
          "A5",
          null
        ]
      },
      "PrintEventRequest": {
        "required": [
          "kind"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "RegisterPatientRequest": {
        "required": [
          "givenName",
          "fatherName",
          "grandfatherName",
          "sex",
          "birthDate",
          "birthDateIsEstimated",
          "phone",
          "nationalId",
          "duplicateOverrideReason"
        ],
        "type": "object",
        "properties": {
          "givenName": {
            "type": [
              "null",
              "string"
            ]
          },
          "fatherName": {
            "type": [
              "null",
              "string"
            ]
          },
          "grandfatherName": {
            "type": [
              "null",
              "string"
            ]
          },
          "sex": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Sex"
              }
            ]
          },
          "birthDate": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "birthDateIsEstimated": {
            "type": "boolean"
          },
          "phone": {
            "type": [
              "null",
              "string"
            ]
          },
          "nationalId": {
            "type": [
              "null",
              "string"
            ]
          },
          "duplicateOverrideReason": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "SelectAffiliationRequest": {
        "required": [
          "affiliationId"
        ],
        "type": "object",
        "properties": {
          "affiliationId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "Sex": {
        "enum": [
          "Female",
          "Male",
          "Other",
          "Unknown",
          null
        ]
      },
      "SignRequest": {
        "required": [
          "draftVersion",
          "allergiesReviewed",
          "allergyReviewToken"
        ],
        "type": "object",
        "properties": {
          "draftVersion": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "allergiesReviewed": {
            "type": "boolean"
          },
          "allergyReviewToken": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      }
    }
