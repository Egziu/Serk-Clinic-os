<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Transitive pinning lets us override vulnerable transitive versions (see docs/security/DEPENDENCY_DECISIONS.md). -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Runtime -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.14" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- Security pin: PDFsharp-MigraDoc 6.2.4 (last MIT-licensed release; 6.3+ is AGPL-3.0-only) depends on System.Security.Cryptography.Pkcs 8.0.1 (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="QRCoder" Version="1.8.1" />
    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
