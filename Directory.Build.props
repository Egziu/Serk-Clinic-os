<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <!-- CA1848/CA1873: LoggerMessage source generators are a perf nicety, not a correctness control; revisit with perf profiling.
         CA1716/CA1724/CA1711: naming collisions with framework namespaces are acceptable for module names like "Clinical". -->
    <NoWarn>$(NoWarn);CA1848;CA1873;CA1716;CA1724;CA1711;CA1062;CA2007;CA1515;CA1031;CA1000;CA1720</NoWarn>
  </PropertyGroup>
</Project>
