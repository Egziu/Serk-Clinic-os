<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Test naming conventions (underscores) and fixture patterns. -->
    <NoWarn>$(NoWarn);CA1707;CA1001;CA1063;CA1816;CA2201;CA1861;CA1859;CA5394;CA1849;CA2000;CA1305;CA1307;CA1310;CA1311;CA1304;CA1862;CA1822;CA1052</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
