{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "App": "",
    "Migrations": ""
  },
  "Database": { "MigrateOnStartup": false },
  "Seed": { "Demo": false },
  "Outbox": { "Enabled": true, "MaxAttempts": 8 },
  "ObjectStore": { "RootPath": "/var/lib/serk/objects" },
  "Documents": { "PublicBaseUrl": "https://clinic.invalid" },
  "RateLimits": { "LoginPerMinute": 10 }
}
